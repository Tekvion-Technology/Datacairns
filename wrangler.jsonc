{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datacairn-site",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },
  "vars": { "STRAPI_URL": "https://stripi.tekvion-me.com", "GITHUB_REPO": "Tekvion-Technology/Datacairns" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls wake the Worker; every page and image is served straight from the asset store.
    "run_worker_first": ["/api/*"]
  }
  // Optional: store form submissions in KV. Create it with
  //   npx wrangler kv namespace create LEADS
  // then uncomment and paste the id:
  // "kv_namespaces": [{ "binding": "LEADS", "id": "<your-namespace-id>" }]
}
