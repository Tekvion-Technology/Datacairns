---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LogoMark from '../components/LogoMark.astro';
---
<BaseLayout title="Page not found · Datacairns" description="This page could not be found.">
  <SiteNav />
  <main class="nf">
    <LogoMark size={72} />
    <h1 class="h-display">Page not found</h1>
    <p>The page you are looking for has moved or does not exist.</p>
    <div class="nf__btns">
      <a href="/" class="btn btn--ink">Back to home</a>
      <a href="/contact/" class="btn btn--mint">Contact us</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 96px 16px; text-align: center; background: var(--porcelain); }
  .nf h1 { font-size: clamp(36px, 5vw, 56px); }
  .nf p { margin: 0; color: var(--slate); font-size: 16px; }
  .nf__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
</style>
