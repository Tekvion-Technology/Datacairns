<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-uc-slide]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-uc-chip]'));
  const count = document.querySelector<HTMLElement>('[data-uc-count]');
  let current = 0;
  const show = (i: number) => {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, k) => (s.hidden = k !== current));
    chips.forEach((c, k) => c.setAttribute('aria-pressed', String(k === current)));
    // Keep the active chip visible when the chip row scrolls sideways (phones).
    const row = chips[0]?.parentElement;
    const chip = chips[current];
    if (row && chip && row.scrollWidth > row.clientWidth) {
      row.scrollTo({ left: chip.offsetLeft - row.offsetLeft - 16, behavior: 'smooth' });
    }
    if (count) count.textContent = `${current + 1} / ${slides.length}`;
  };
  document.querySelector('[data-uc-prev]')?.addEventListener('click', () => show(current - 1));
  document.querySelector('[data-uc-next]')?.addEventListener('click', () => show(current + 1));
  chips.forEach((c, k) => c.addEventListener('click', () => show(k)));

  // Swipe between use cases on touch screens.
  const track = slides[0]?.parentElement;
  let startX = 0;
  track?.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  track?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
